Roman = {
    'I': 1,
    'V': 5,
    'X': 10,
    'L': 50,
    'C': 100,
    'D': 500,
    'M': 1000,
}
class Solution(object):
    def romanToInt(self, s):
        """
        :type s: str
        :rtype: int
        """
        num = 0 
        for i in range(len(s) - 1):
            num += Roman[s[i]] if Roman[s[i]] >= Roman[s[i+1]] else  -Roman[s[i]]
        return num + Roman[s[-1]]
