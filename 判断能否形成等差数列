#给你一个数字数组 arr 。
#如果一个数列中，任意相邻两项的差总等于同一个常数，那么这个数列就称为 等差数列 。
#如果可以重新排列数组形成等差数列，请返回 true ；否则，返回 false 。

class Solution(object):
    def canMakeArithmeticProgression(self, arr):
        """
        :type arr: List[int]
        :rtype: bool
        """
        n = len(arr)
        arr = sorted(arr)
        d = arr[1] - arr[0]
        for i in range(2,n):
            if arr[i] - arr[i-1] == d:
                continue
            else:
                return False
                break    
        else:
            return True
            
#题目很简单，排序之后比较相邻项目的差看看是不是一样就行了。            

          

            
